# Copie este arquivo para .env. Nunca envie o .env ao GitHub.
PORT=4173
HOST=127.0.0.1
COOKIE_SECURE=false

# O servidor gera estes três valores automaticamente no .env na primeira execução.
# Se configurar manualmente, use valores aleatórios longos e nunca os reutilize.
AUTH_SESSION_SECRET=GERADO_AUTOMATICAMENTE_EM_BASE64URL
AUTH_ENCRYPTION_KEY=GERADO_AUTOMATICAMENTE_COM_32_BYTES_EM_BASE64

# Gere uma URL Webcal nova no ADVBOX, pois a anterior foi exposta no chat.
ADVBOX_WEBCAL_URL=webcal://COLE_A_NOVA_URL_SOMENTE_NESTE_ARQUIVO

# Use uma sequência longa e aleatória; o mesmo valor deve ficar apenas neste computador.
COLLECTOR_INGEST_TOKEN=troque-por-um-segredo-local-longo
CENTRAL_URL=http://127.0.0.1:4173

# Compatibilidade legada. Prefira Integrações → Certificado digital e 2FA,
# que grava o PFX, a senha e os TOTP no cofre AES-256-GCM local.
A1_PFX_PATH=C:\caminho-protegido\certificado.pfx
A1_PFX_PASSPHRASE=

# Primeira execução deve ser visível para login, QR code, CAPTCHA ou 2FA manual.
COLLECTOR_HEADLESS=false
COLLECTOR_INTERACTIVE=true
LOGIN_WAIT_SECONDS=180

# PJe: use o PJeOffice Pro oficial. A automação de TOTP é opcional e vem desligada.
# Antes de ativá-la, revogue o QR/segredo que já foi compartilhado e gere outro no PJe/PDPJ.
ALLOW_AUTOMATED_PORTAL_TOTP=false
PJE_TOTP_SECRET=

# DataJud: a chave pública vigente pode ser atualizada automaticamente a partir da página oficial do CNJ.
DATAJUD_API_KEY=
DATAJUD_AUTO_REFRESH_KEY=true
DATAJUD_KEY_URL=https://datajud-wiki.cnj.jus.br/api-publica/acesso/

# Para executar apenas portais específicos, informe IDs separados por vírgula.
COLLECTOR_PORTAL_IDS=

# Somente para uma futura hospedagem Supabase. A chave service_role é exclusiva do servidor.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=COLE_SOMENTE_NO_AMBIENTE_DE_HOSPEDAGEM
SUPABASE_SERVICE_ROLE_KEY=NUNCA_EXPOR_NO_NAVEGADOR_OU_GITHUB
